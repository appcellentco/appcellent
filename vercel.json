{
  "buildCommand": "true",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "studfinder.appcellent.co"
        }
      ],
      "destination": "/studfinder/:path*"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "tcgvault.appcellent.co"
        }
      ],
      "destination": "/tcgvault/:path*"
    },
    {
      "source": "/",
      "destination": "/main/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/main/:path*"
    }
  ]
}
